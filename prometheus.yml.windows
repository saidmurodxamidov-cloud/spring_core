# Prometheus configuration file for Windows
# Alternative configuration if host.docker.internal doesn't work
# Replace prometheus.yml with this file if needed

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: 'gym-management-system'

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # Scrape Spring Boot application metrics
  # Option 1: Use host.docker.internal (should work with extra_hosts in docker-compose)
  - job_name: 'spring-boot-app'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets: ['host.docker.internal:8080']
        labels:
          application: 'gym-management-system'
          environment: 'local'
    scrape_interval: 30s
    scrape_timeout: 10s

  # Option 2: If host.docker.internal doesn't work, use your actual Windows host IP
  # Find your IP with: ipconfig (look for IPv4 Address)
  # Uncomment and replace 192.168.x.x with your actual IP:
  # - job_name: 'spring-boot-app-ip'
  #   metrics_path: '/actuator/prometheus'
  #   static_configs:
  #     - targets: ['192.168.1.100:8080']  # Replace with your Windows host IP
  #       labels:
  #         application: 'gym-management-system'
  #         environment: 'local'
  #   scrape_interval: 30s
  #   scrape_timeout: 10s

